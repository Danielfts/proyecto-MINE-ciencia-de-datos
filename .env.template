# Plantilla de configuración de voz para los videos (ver herramientas_video/voz.py).
# Copie este archivo como .env, en la raíz del repositorio, y complete la llave.
# El .env no se sube a git.

# "gemini" genera la voz con Gemini TTS; "silencio" renderiza sin voz, con la
# duración estimada de cada frase (sirve para ajustar el ritmo sin gastar cuota).
# Sin esta variable se usa "silencio".
VOZ_SERVICIO=gemini

# Llave de API de Vertex AI, creada en un proyecto de Google Cloud con Vertex AI
# habilitado. No sirve una llave que solo tenga acceso a la API de Gemini
# (generativelanguage.googleapis.com), salvo que se ponga VOZ_VERTEX=0.
GEMINI_API_KEY=

VOZ_MODELO=gemini-3.1-flash-tts-preview
VOZ_IDIOMA=es-419

# Voz de la narración que no tiene integrante asignado. La voz de cada integrante
# está en herramientas_video/creditos.py.
VOZ_NOMBRE=Zephyr

# Opcional: instrucción de estilo que se antepone a cada frase.
# VOZ_ESTILO=

# Opcional: 0 si la llave es de la API de Gemini (AI Studio) y no de Vertex AI.
# No se ha probado con una llave de ese tipo.
# VOZ_VERTEX=0
