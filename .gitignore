# Material de referencia del curso: solo local, ver course-contents/README.md
course-contents/*
!course-contents/README.md

# Bitácora privada de uso de IA; la versión que se entrega es USO_DE_IA.md
USO_DE_IA.borrador.md
USO_DE_IA_NICOLAS.md

# Entorno de Python
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Salida de manim (los videos finales se publican en YouTube)
media/

# Credenciales y configuración local de voz (ver .env.template)
.env

# Archivos auxiliares de LaTeX (el PDF del reporte sí se sube)
entrega-*/reporte/*.aux
entrega-*/reporte/*.bbl
entrega-*/reporte/*.bcf
entrega-*/reporte/*.blg
entrega-*/reporte/*.fdb_latexmk
entrega-*/reporte/*.fls
entrega-*/reporte/*.log
entrega-*/reporte/*.out
entrega-*/reporte/*.run.xml
entrega-*/reporte/*.synctex.gz
entrega-*/reporte/*.toc
# En el diccionario de datos solo se suben la fuente, el PDF y la configuración de latexmk
datos/predios/diccionario/*
!datos/predios/diccionario/*.tex
!datos/predios/diccionario/*.pdf
!datos/predios/diccionario/.latexmkrc

# Respaldos y archivos de transferencia de la base catastral: tienen datos personales
*.dump
*.backup
*.xtf
*.sql.gz
catastro_*.sql
# Exportaciones de la base (ver datos/predios/README.md): no se publican
*.parquet

# Archivos del municipio (facturación y recaudo del predial): tienen datos personales
# y sus nombres o contenidos identifican al municipio. No se publican.
*.xlsx
*.xls
*.csv.gz
# Archivos de bloqueo de LibreOffice (su nombre repite el del archivo abierto)
.~lock.*#

# Grabaciones originales de los integrantes para los videos (fuente del audio; el video final está en YouTube)
entrega-*/video/audios/
*.opus
*.ogg
*.wav
*.mp3
*.m4a
