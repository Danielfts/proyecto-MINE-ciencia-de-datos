<DefLangMetaAttrb>(Institucional) Aula de clases</DefLangMetaAttrb>
<Documentation>14426</Documentation>
<DefLangName>Aulas_de_Clases</DefLangName>
</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="14425">
<Entry TID="14427" language="es" translation="EnumElement1568"/>
