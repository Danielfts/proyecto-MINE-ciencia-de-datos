</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="14474">
<Entry TID="14475" language="es" translation="Cada una de las superficies de un edificio que disponen de una cara al interior y de otra al exterior."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14473">
