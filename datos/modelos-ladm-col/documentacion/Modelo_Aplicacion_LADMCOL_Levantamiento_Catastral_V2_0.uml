<DefLangName>Infraestructura_Transporte</DefLangName>
</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="13431">
<Entry TID="13435" language="es" translation="Infraestructura_Transporte"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="13432">
<Entry TID="13436" language="es" translation="Infraestructura transporte"/>
