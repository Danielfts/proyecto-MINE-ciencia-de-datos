<ch.ehi.basics.types.NlsString TID="14485">
<Entry TID="14486" language="es" translation="Tenso estructuras, arquitectura textil, o membranas arquitect&#243;nicas, son los nombres con los que se le conoce a los tipos de estructura que emplean materiales que trabajan bajo tensi&#243;n, sean membranas textiles, l&#225;minas, mallas de cables, etc."/>
</ch.ehi.basics.types.NlsString>
