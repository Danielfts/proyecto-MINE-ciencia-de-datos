</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="14949">
<Entry TID="14950" language="es" translation="Es una casa de tres niveles cuya funci&#243;n arquitect&#243;nica y ambiental principal, es dar albergue en forma adecuada a una familia."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14947">
<Entry TID="14951" language="es" translation="(Residencial) Vivienda hasta 3 pisos"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14948">
<Entry TID="14952" language="es" translation="EnumElement1531"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14946">
