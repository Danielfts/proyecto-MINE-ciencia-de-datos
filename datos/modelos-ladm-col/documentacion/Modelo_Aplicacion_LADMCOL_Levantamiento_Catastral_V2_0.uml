</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="14444">
<Entry TID="14445" language="es" translation="Es la edificaci&#243;n o establecimiento que brinda servicios recreativos y tiene capacidad para ciertos juegos de azar."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14442">
<Entry TID="14446" language="es" translation="(Comercial) Clubes - Casinos"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14443">
