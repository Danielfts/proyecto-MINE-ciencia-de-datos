<ch.ehi.basics.types.NlsString TID="14441">
<Entry TID="14448" language="es" translation="Clubes_Casinos"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="13930">
<Entry TID="14449" language="es" translation="EnumElement1564"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14046">
<Entry TID="14450" language="es" translation="Se denomina a la construcci&#243;n con caracter&#237;sticas arquitect&#243;nicas coloniales, en el cual se lleva a cabo una actividad socioecon&#243;mica que consiste en el intercambio de algunos materiales en el mercado de compra y venta de bienes."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14269">
<Entry TID="14451" language="es" translation="Construcci&#243;n de grandes dimensiones que sirve para almac&#233;n o dep&#243;sito, se except&#250;an los silos cafeteros."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.interlis.domainsandconstants.basetypes.EnumElement TID="13997">
