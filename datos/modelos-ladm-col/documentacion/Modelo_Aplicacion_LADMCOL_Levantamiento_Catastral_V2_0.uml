<ch.ehi.basics.types.NlsString TID="14901">
<Entry TID="14902" language="es" translation="Corresponde a edificaciones residenciales desarrolladas sobre un lote de terreno que comprende m&#225;s de tres unidades prediales independientes, generalmente en edificios de varios pisos. Este tipo de vivienda prev&#233; &#225;reas de servicios comunales cuya propiedad y utilizaci&#243;n privada se definen en reglamentos de propiedad horizontal."/>
