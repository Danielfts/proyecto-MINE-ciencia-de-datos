<ch.ehi.basics.types.NlsString TID="14416">
<Entry TID="14421" language="es" translation="(Anexo) P&#233;rgolas"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14418">
<Entry TID="14422" language="es" translation="Las p&#233;rgolas son estructuras compuestas por columnas y una armaz&#243;n superior, cubiertas con mucho follaje o toldo especial que protegen de la lluvia y el sol, tambi&#233;n usadas como elemento decorativo en un espacio de las viviendas."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.interlis.domainsandconstants.basetypes.EnumElement TID="13792">
