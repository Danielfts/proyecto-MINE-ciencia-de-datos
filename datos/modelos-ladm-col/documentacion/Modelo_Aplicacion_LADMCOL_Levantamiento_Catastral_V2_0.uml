<ch.ehi.basics.types.NlsString TID="12661">
<Entry TID="12679" language="es" translation="T&#237;tulo mal inscrito no corresponde al predio"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="12665">
<Entry TID="12680" language="es" translation="FMI sin correspondencia catastral"/>
