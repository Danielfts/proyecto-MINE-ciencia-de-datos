</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="14455">
<Entry TID="14456" language="es" translation="Establecimiento que ocupa un edificio total o parcialmente que ofrece alojamiento."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14453">
