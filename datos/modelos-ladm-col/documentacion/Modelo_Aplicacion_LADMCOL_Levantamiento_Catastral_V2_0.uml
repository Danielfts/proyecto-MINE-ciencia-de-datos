</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="14465">
<Entry TID="14466" language="es" translation="Construcci&#242;n destinada a la cr&#237;a y albergue de cerdos. Se utiliza cualesquiera de los tres nombres enunciados seg&#250;n la regi&#243;n donde se ubique; los elementos que la conforman son: estructura, muros y pisos. "/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14463">
<Entry TID="14467" language="es" translation="(Anexo) Cocheras - Marraneras - Porquerizas"/>
