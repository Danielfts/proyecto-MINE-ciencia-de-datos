<ch.ehi.basics.types.NlsString TID="8945">
<Entry TID="8948" language="es" translation="Es la estimaci&#243;n del valor de un inmueble a una fecha determinada conforme a las reglas del mercado inmobiliario y la normatividad vigente."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="8943">
<Entry TID="8949" language="es" translation="Aval&#250;o comercial Terreno"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="8906">
<Entry TID="8950" language="es" translation="Avaluo_Comercial_Unidad_Construccion"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="8866">
<Entry TID="8951" language="es" translation="Peso"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="8895">
<Entry TID="8952" language="es" translation="Para el aval&#250;o de la unidad constructiva, en caso de modelos econom&#233;tricos, se deben tener en cuenta el tipo de estructura, los acabados, el ba&#241;o, la cocina, el estado de conservaci&#243;n, la edad de la edificaci&#243;n, el uso que se le da a dichas construcciones, entre otros, lo cual es valorado de acuerdo con las condiciones que presente el inmueble.&#8203;&#10;Para el caso de actualizaci&#243;n de Zonas Homog&#233;neas y tablas de construcci&#243;n se utilizan variables de puntaje, uso de la construcci&#243;n y &#225;rea construida para la determinaci&#243;n del aval&#250;o.&#8203;&#10;El aval&#250;o catastral de la unidad corresponde a un porcentaje adoptado del aval&#250;o comercial seg&#250;n el estudio econ&#243;mico."/>
</ch.ehi.basics.types.NlsString>
