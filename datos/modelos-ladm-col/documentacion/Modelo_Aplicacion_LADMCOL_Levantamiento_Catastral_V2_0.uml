</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14426">
<Entry TID="14430" language="es" translation="Es un sal&#243;n de un edificio que se destina a actividades de ense&#241;anza, y es la unidad b&#225;sica de todo recinto destinado a la educaci&#243;n."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.interlis.domainsandconstants.basetypes.EnumElement TID="14201">
<Name>14431</Name>
<Enumeration>14181</Enumeration>
<MetaAttrb>14432</MetaAttrb>
<NameList>14433</NameList>
<DefLangMetaAttrb>(Anexo) Estaci&#243;n de sistema de transporte</DefLangMetaAttrb>
<Documentation>14434</Documentation>
<DefLangName>Estacion_Sistema_Transporte</DefLangName>
</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="14431">
<Entry TID="14435" language="es" translation="Estacion_Sistema_Transporte"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14434">
<Entry TID="14436" language="es" translation="Instalaci&#243;n que permite el tr&#225;nsito de personas y la conexi&#243;n con sistemas de transporte como buses, metro, tren, tranv&#237;a, terminales y estaciones, destinadas para la movilidad de las personas."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14432">
<Entry TID="14437" language="es" translation="(Anexo) Estaci&#243;n de sistema de transporte"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14433">
<Entry TID="14438" language="es" translation="EnumElement1602"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14336">
<Entry TID="14439" language="es" translation="EnumElement1605"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14235">
<Entry TID="14440" language="es" translation="Construcciones elaboradas con el objeto de secar en condiciones naturales el caf&#233; principalmente, aunque es com&#250;n su uso en otros productos. Consta de estructura y pisos para su calificaci&#243;n."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.interlis.domainsandconstants.basetypes.EnumElement TID="13991">
