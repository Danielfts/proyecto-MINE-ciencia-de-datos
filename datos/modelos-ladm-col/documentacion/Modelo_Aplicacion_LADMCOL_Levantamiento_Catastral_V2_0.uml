</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="14493">
<Entry TID="14494" language="es" translation="Superficie de terreno adecuada sobre una placa para la pr&#225;ctica de deportes como f&#250;tbol de sal&#243;n, voleibol, baloncesto u alguna otra disciplina que haga uso de la cancha, todo ello a peque&#241;a escala. Se excluyen las canchas de tenis, los estadios, coliseo u otras edificaciones de gran tama&#241;o."/>
</ch.ehi.basics.types.NlsString>
