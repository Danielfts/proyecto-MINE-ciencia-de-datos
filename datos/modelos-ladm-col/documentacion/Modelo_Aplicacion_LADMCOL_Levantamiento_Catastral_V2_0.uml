<ch.ehi.basics.types.NlsString TID="15589">
<Entry TID="15591" language="es" translation="Son los derivados participaci&#243;n de la comunidad en el suministro de informaci&#243;n que sirva como insumo para el desarrollo de los procesos catastrales. Los gestores catastrales propender&#225;n por la adopci&#243;n nuevas tecnolog&#237;as y procesos comunitarios que faciliten la participaci&#243;n los ciudadanos."/>
