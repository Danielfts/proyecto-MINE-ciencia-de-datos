</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14101">
<Entry TID="14460" language="es" translation="Es el espacio que con &#225;nimo de lucro se destina a guardar o arrendar espacios para depositar veh&#237;culos dentro de una edificaci&#243;n construida para tal fin, o dentro de un predio habilitado con el mismo objeto."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="13940">
<Entry TID="14461" language="es" translation="(Industrial) Industrias en PH"/>
</ch.ehi.basics.types.NlsString>
