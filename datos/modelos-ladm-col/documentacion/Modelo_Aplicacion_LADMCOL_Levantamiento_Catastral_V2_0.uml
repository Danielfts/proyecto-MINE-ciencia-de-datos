<ch.ehi.basics.types.NlsString TID="12663">
<Entry TID="12682" language="es" translation="Cuando se encuentra un titulo inscrito que no corresponde al predio objeto de estudio.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="12672">
<Entry TID="12683" language="es" translation="Cuando el estado del FMI del predio en estudio es CERRADO ante la SNR, pero pese a haberse realizado varios negocios jur&#237;dicos sobre un predio (ventas, donaciones, segregaciones, etc.) se identifica que este posee un &#225;rea de remanente, lo que le permite continuar con su existencia jur&#237;dica y su estado debe cambiar a ABIERTO.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="12667">
<Entry TID="12684" language="es" translation="FMI que despu&#233;s de la intervenci&#243;n, no fue posible identificar en territorio y no se encuentra relacionado a ning&#250;n predio del la base catastral resultante de la actualizaci&#243;n.&#10;"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="12676">
<Entry TID="12685" language="es" translation="Cuando el estado del FMI del predio en estudio es ABIERTO ante la SNR, pero el folio ha sido cancelado por orden de autoridad  judicial y/o administrativa, o se agote su &#225;rea por englobes, desenglobes o cualquier otro negocio jur&#237;dico  y su estado debe cambiar a CERRADO."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="12670">
<Entry TID="12686" language="es" translation="FMI debe estar abierto"/>
</ch.ehi.basics.types.NlsString>
