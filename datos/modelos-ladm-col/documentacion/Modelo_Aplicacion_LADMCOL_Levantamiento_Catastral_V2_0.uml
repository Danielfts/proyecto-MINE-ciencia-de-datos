<Entry TID="13445" language="es" translation="Servicios funerarios"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="13442">
<Entry TID="13446" language="es" translation="Se califica con destino infraestructura de servicios funerarios, aquellos predios que prestan servicios de velatorio, cremaci&#243;n y entierro de personas fallecidas, incluye los cementerios, funerarias, morgue, anfiteatros, crematorios y dem&#225;s relacionados."/>
</ch.ehi.basics.types.NlsString>
