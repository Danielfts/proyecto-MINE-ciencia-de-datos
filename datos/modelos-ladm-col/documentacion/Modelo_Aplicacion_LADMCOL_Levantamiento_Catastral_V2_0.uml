</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14239">
<Entry TID="14469" language="es" translation="Se denomina muralla a un muro cerrado destinado a la protecci&#243;n y defensa de determinado sitio."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14069">
<Entry TID="14470" language="es" translation="EnumElement1542"/>
</ch.ehi.basics.types.NlsString>
