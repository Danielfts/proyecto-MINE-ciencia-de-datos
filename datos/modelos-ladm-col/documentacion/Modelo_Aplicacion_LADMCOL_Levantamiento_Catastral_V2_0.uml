<Entry TID="14478" language="es" translation="Cerramiento"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14314">
<Entry TID="14479" language="es" translation="Lugar cubierto donde se encierra ganado o caballos y/o se realizan actividades propias de su explotaci&#243;n, constituidos por estructura, cubierta, muros y pisos."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="14153">
