<ch.ehi.basics.types.NlsString TID="14811">
<Entry TID="14821" language="es" translation="Una escritura p&#250;blica es un documento p&#250;blico en el que se realiza ante un notario p&#250;blico un determinado hecho o un derecho autorizado por dicho fedatario p&#250;blico, que firma con el otorgante u otorgantes,mostrando sobre la capacidad jur&#237;dica del contenido y de la fecha en que se realiz&#243;"/>
</ch.ehi.basics.types.NlsString>
