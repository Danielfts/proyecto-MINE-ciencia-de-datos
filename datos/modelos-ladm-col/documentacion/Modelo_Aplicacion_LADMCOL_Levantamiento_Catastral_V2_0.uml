</ch.ehi.interlis.domainsandconstants.basetypes.EnumElement>
<ch.ehi.basics.types.NlsString TID="11101">
<Entry TID="11102" language="es" translation="Son el grupo humano que vive de acuerdo con las formas de relaci&#243;n con el medio natural en el que se asentaron los diferentes grupos abor&#237;genes desde antes de la conquista y la han conservado y dinamizado a lo largo de la historia."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="11100">
<Entry TID="11103" language="es" translation="EnumElement1211"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="11099">
<Entry TID="11104" language="es" translation="Ind&#237;gena"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="11098">
<Entry TID="11105" language="es" translation="Indigena"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="11096">
<Entry TID="11106" language="es" translation="Es el conjunto de familias de ascendencia afrocolombiana que poseen una cultura propia, comparten una historia y tienen sus propias tradiciones y costumbres dentro de la relaci&#243;n campo-poblado, adem&#225;s revelan y conservan conciencia de identidad que las distinguen de otros grupos &#233;tnicos. Se suele denominar a este grupo humano como negros, morenos, mulatos y afrodescendientes."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.interlis.domainsandconstants.basetypes.EnumElement TID="11089">
<Name>11107</Name>
<Enumeration>11079</Enumeration>
