<ch.ehi.basics.types.NlsString TID="11113">
<Entry TID="11117" language="es" translation="Ninguno"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="11116">
<Entry TID="11118" language="es" translation="No pertenece a ning&#250;n grupo &#233;tnico."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="11114">
<Entry TID="11119" language="es" translation="Ninguno"/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="11110">
<Entry TID="11120" language="es" translation="Es la poblaci&#243;n nativa de las Islas de San Andr&#233;s, Providencia Y Santa Catalina descendientes de la uni&#243;n entre europeos (principalmente ingleses, espa&#241;oles y holandeses) y esclavos africanos. Se distinguen por su cultura, lengua (creole), creencias religiosas (iglesia bautista) y pasado hist&#243;rico similar a los pueblos antillanos como Jamaica y Hait&#237;."/>
</ch.ehi.basics.types.NlsString>
<ch.ehi.basics.types.NlsString TID="11095">
<Entry TID="11121" language="es" translation="EnumElement1207"/>
</ch.ehi.basics.types.NlsString>
