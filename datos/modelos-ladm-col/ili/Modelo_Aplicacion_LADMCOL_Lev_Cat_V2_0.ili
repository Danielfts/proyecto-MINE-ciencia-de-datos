    /** Datos de adicionales del predio para catastro multipropósito.
     */
    !!@ ili2db.dispName = "(LC) Datos adicionales levantamiento catastral"
    CLASS LC_DatosAdicionalesLevantamientoCatastral =
      /** Área consignada en el certificado de tradición y libertad, en la descripción de cabida y linderos o en los títulos registrados, expresada en metros cuadrados.
       */
      !!@ ili2db.dispName = "Área registral en metros cuadrados"
      Area_Registral_M2 : 0.00 .. 10000000000000000000000.00 [LADM_COL_V3_1.m2];
      /** Relaciona los cambios del predio respecto de la información catastral vigente.
       */
      !!@ ili2db.dispName = "Novedad números prediales"
      Novedad_Numeros_Prediales : BAG {0..*} OF Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.Levantamiento_Catastral.LC_EstructuraNovedadNumeroPredial;
      /** Relaciona los cambios del predio respecto de la información registral vigente.
       */
      !!@ ili2db.dispName = "Novedad folio de matrícula de inmobiliaria"
      Novedad_FMI : BAG {0..*} OF Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.Levantamiento_Catastral.LC_NovedadFMI;
      /** Observaciones generales respecto del predio.
       */
      !!@ ili2db.dispName = "Observaciones"
      Observaciones : MTEXT*500;
      /** Fecha de la visita en campo al predio.
       */
      !!@ ili2db.dispName = "Fecha de visita predial"
      Fecha_Visita_predial : INTERLIS.XMLDate;
      /** Posibles situaciones que se presentan y afectan el resultado del levantamiento de la información en campo.
       */
      !!@ ili2db.dispName = "Resultado de la visita predial"
      Resultado_Visita : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.LC_ResultadoVisitaTipo;
    END LC_DatosAdicionalesLevantamientoCatastral;

    /** Clase especializada de BaUnit, que describe la unidad administrativa básica para el caso de Colombia.
     * El predio es la unidad territorial legal propia de Catastro. Está formada por el terreno y puede o no tener construcciones asociadas.
     */
    !!@ ili2db.dispName = "(LC) Predio"
    CLASS LC_Predio
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadAdministrativaBasica =
      /** Corresponde al código del departamento al cual pertenece el predio. Es asignado por DIVIPOLA y tiene 2 dígitos.
       */
      !!@ ili2db.dispName = "Departamento"
      Departamento : MANDATORY TEXT*2;
      /** Corresponde al código del municipio al cual pertenece el predio. Es asignado por DIVIPOLA y tiene 3 dígitos.
       */
      !!@ ili2db.dispName = "Municipio"
      Municipio : MANDATORY TEXT*3;
      /** Dirección del predio.
       */
      !!@ ili2db.dispName = "Dirección"
      Direccion : BAG {1..*} OF LADM_COL_V3_1.LADM_Nucleo.ExtDireccion;
      /** Identificador único temporal de cada predio que se asigna en el desarrollo del levantamiento catastral.
       */
      !!@ ili2db.dispName = "Identificador único de operación"
      Id_Operacion : MANDATORY TEXT*30;
      /** Circulo registral
       */
      !!@ ili2db.dispName = "Código ORIP"
      Codigo_ORIP : TEXT*4;
      /** Matricula inmobiliaria
       */
      !!@ ili2db.dispName = "Matrícula inmobiliaria"
      Matricula_Inmobiliaria : 0 .. 9999999999;
      /** Registro asociado a la anotación en antiguo sistema de registro. (Libros)
       */
      !!@ ili2db.dispName = "Referencia registral del sistema antiguo"
      Referencia_Registral_Sistema_Antiguo : Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.Levantamiento_Catastral.ExtReferenciaRegistralSistemaAntiguo;
      /** Nuevo Código numérico de treinta (30) dígitos, que se le asigna a cada predio y busca localizarlo inequívocamente en los documentos catastrales, según el modelo determinado por el Instituto Geográfico Agustín Codazzi.
       */
      !!@ ili2db.dispName = "Número predial"
      Numero_Predial : MANDATORY TEXT*30;
      /** Es un código único para identificar los inmuebles en los sistemas de información catastral.
       */
      !!@ ili2db.dispName = "Código homologado"
      Codigo_Homologado : TEXT*11;
      /** El avalúo catastral consiste en la determinación del valor de los predios, obtenido mediante investigación y análisis estadístico del mercado inmobiliario. ?
       * 
       * El avalúo catastral de cada predio se determinará por la adición de los avalúos parciales practicados independientes o no, para los terrenos y para las unidades de construcción en él comprendidos.?
       * 
       * El avalúo catastral corresponde a un porcentaje adoptado del avalúo comercial según el estudio económico, dichos avalúos se redondean a miles.
       */
      !!@ ili2db.dispName = "Avalúo catastral"
      Avaluo_Catastral : LADM_COL_V3_1.LADM_Nucleo.Peso;
      /** Indica el tipo predio para efectos catastrales.
       */
      !!@ ili2db.dispName = "Tipo de predio"
      Tipo (EXTENDED) : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.LC_PredioTipo;
      /** Corresponde a una caracterización temática de las condiciones de predio que se está censando relacionada a aspectos físicos y jurídicos.
       */
      !!@ ili2db.dispName = "Condición del predio"
      Condicion_Predio : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.LC_CondicionPredioTipo;
      /** Es la clasificación para fines estadísticos y económicos que se da a cada inmueble en su conjunto–terreno, construcciones o edificaciones-, en el momento de la identificación predial de conformidad con la actividad predominante que en él se desarrolle.
       */
      !!@ ili2db.dispName = "Destinación económica"
      Destinacion_Economica : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.LC_DestinacionEconomicaTipo;
      UNIQUE Id_Operacion; 
      !!@ name = "ValidacionValoresPredioTipo"
      MANDATORY CONSTRAINT Tipo <> #Ordenamiento_Territorial ;
      MANDATORY CONSTRAINT Tipo <> #Servicios_Publicos ;
      MANDATORY CONSTRAINT Tipo <> #Reservas_Naturales ;
      MANDATORY CONSTRAINT Tipo <> #Parques_Naturales ;
      MANDATORY CONSTRAINT Tipo <> #Amenazas_Riesgos ;
      MANDATORY CONSTRAINT Tipo <> #Servidumbre ;
      MANDATORY CONSTRAINT Tipo <> #Superficies_Agua ;
      MANDATORY CONSTRAINT Tipo <> #Transporte ;
    END LC_Predio;

    ASSOCIATION cr_construccion_unidadconstruccion =
      cr_unidadconstruccion -- {0..*} CR_UnidadConstruccion;
      cr_construccion -- {0..1} CR_Construccion;
    END cr_construccion_unidadconstruccion;

    ASSOCIATION cr_unidadconstruccion_caracteristicasunidadconstruccion =
      cr_caracteristicasunidadconstruccion -- {1} CR_CaracteristicasUnidadConstruccion;
      cr_unidadconsutruccion -- {1..*} CR_UnidadConstruccion;
    END cr_unidadconstruccion_caracteristicasunidadconstruccion;

    ASSOCIATION lc_interesado_interesadocontacto =
      lc_contacto -- {0..*} LC_InteresadoContacto;
      cr_interesado -- {1} CR_Interesado;
    END lc_interesado_interesadocontacto;

    /** Relación entre unidades prediales y predios matrices bajo el régimen de propiedad horizontal y condominio.
     */
    ASSOCIATION cr_predio_copropiedad =
      /** Area privada de terreno matriz, adicional a la participación en el terreno común, según el coeficiente allí determinado.
       */
      unidad_predial -- {0..*} LC_Predio;
      /** Unidades residenciales tales como edificios, conjuntos y tipos de urbanizaciones cerradas en las que se comparten áreas comunes y que tienen régimen de propiedad horizontal.
       */
      matriz -<> {0..1} LC_Predio;
      /** Coeficiente de copropiedad de la unidad predial.
       */
      !!@ ili2db.dispName = "Coeficiente"
      Coeficiente : 0.0000000000 .. 1.0000000000;
    END cr_predio_copropiedad;

    ASSOCIATION lc_informacion_adicional_contacto =
      lc_contacto_visita -- {0..*} LC_ContactoVisita;
      lc_datos_adicionales -- {1} LC_DatosAdicionalesLevantamientoCatastral;
    END lc_informacion_adicional_contacto;

    /** Relación entre el Predio catastral y la clase información adicional, que permite determinar sobre qué predio se toman los datos específicos del predio para catastro multipropósito
     */
    ASSOCIATION lc_informacion_adicional_predio =
      lc_predio (EXTERNAL) -- {1} LC_Predio;
      lc_datos_adicionales -- {0..1} LC_DatosAdicionalesLevantamientoCatastral;
    END lc_informacion_adicional_predio;

    ASSOCIATION lc_ph_predio =
      lc_predio -- {1} LC_Predio;
      lc_datos_ph -- {0..1} CR_DatosPHCondominio;
    END lc_ph_predio;

    ASSOCIATION lc_predio_informalidad =
      lc_predio_formal -- {0..*} LC_Predio;
      lc_predio_informal -- {0..*} LC_Predio;
    END lc_predio_informalidad;

    ASSOCIATION lc_predio_ini_predioinsumos =
      ini_predio_insumos (EXTERNAL) -- {0..*} Submodelo_Integracion_Insumos_V1_0.Datos_Integracion_Insumos.INI_PredioInsumos;
      lc_predio -- {0..*} LC_Predio;
    END lc_predio_ini_predioinsumos;

  END Levantamiento_Catastral;

END Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.
