        /** Apartamento, garaje, depósito o cualquier otro tipo de unidad predial dentro del PH que se encuentra debidamente inscrito en el registro de instrumentos públicos.
         */
        !!@ ili2db.dispName = "(Propiedad horizontal) Unidad Predial"
        Unidad_Predial
      ),
      /** Predio sometido al régimen de propiedad horizontal mediante escritura pública registrada en cuyo reglamento define para cada unidad predial un área privada de terreno.
       */
      !!@ ili2db.dispName = "Condominio"
      Condominio(
        /** Predio matriz del condominio sobre el cual se segregan todas las unidades prediales.
         */
        !!@ ili2db.dispName = "(Condominio) Matriz"
        Matriz,
        /** Unidad predial dentro del condominio matriz.
         */
        !!@ ili2db.dispName = "(Condominio) Unidad predial"
        Unidad_Predial
      ),
      /** Predios sobre los cuales las áreas de terreno y construcciones son dedicadas a la cremación, inhumación o enterramiento de personas fallecidas.
       */
      !!@ ili2db.dispName = "Parque cementerio"
      Parque_Cementerio(
        /** Predios sobre los cuales las áreas de terreno y construcciones son dedicadas a la cremación, inhumación o enterramiento de personas fallecidas.
         */
        !!@ ili2db.dispName = "(Parque cementerio) Matriz"
        Matriz,
        /** Área o sección de terreno con función de tumba, esta debe encontrarse inscrita en el registro de instrumentos públicos.
         */
        !!@ ili2db.dispName = "(Parque Cementerio) Unidad predial"
        Unidad_Predial
      ),
      /** Espacio (terreno y construcción) diseñado y destinado para el tránsito de vehículos, personas, entre otros.
       */
      !!@ ili2db.dispName = "Vía"
      Via,
      /** Predios asociados a las formas de tenencia de ocupación o posesión.
       */
      !!@ ili2db.dispName = "Informal"
      Informal,
      /** Inmuebles que siendo de dominio de la Nación, o una entidad territorial o de particulares, están destinados al uso de los habitantes.
       */
      !!@ ili2db.dispName = "Bien de uso público"
      Bien_Uso_Publico
    );

    LC_DerechoTipo = (
      /** El dominio que se llama también propiedad es el derecho real en una cosa corporal, para gozar y disponer de ella arbitrariamente, no siendo contra ley o contra derecho ajeno. (Art. 669 CC):
       * 
       * Códigos antiguos:
       * 101 102 103 104 105 107 108 109 110 111 112 113 114 115 117 118 119 121 150 151 170 171 181 191 920
       * Códigos nuevos:
       * 0101 0102 0103 0104 0105 0106 0107 0108 0109 0110 0111 0112 0113 0114 0115 0116 0117 0118 0119 0120 0121 0122 0124 0125 0126 0127 0128 0129 0130 0131 0132 0133 0135 0136 0137 0138 0139 0140 0141 0142 0143 0144 0145 0146 0147 0148 0150 0151 0152 0153 0154 0155 0156 0157 0158 0159 0160 0161 0162 0163
       * 0164 0165 0166 0167 0168 0169 0171 0172 0173 0175 0177 0178 0179 0180 0181 0182 0183 0184 0185 0186 0187 0188 0189 0190 0191 0192 0193 0194 0195 0197 0198 0199 01001 01002 01003 01004 01005 01006 01007 01008 01009 01010 01012 01013 01014 01015 01016 01017 01018 01019.
       */
      !!@ ili2db.dispName = "Dominio"
      Dominio,
      /** En el ámbito de la gestión catastral, es el polígono que representa el asentamiento de personas naturales o jurídicas dentro de un terreno baldío, el cual puede contar o no con construcciones y/o edificaciones.
       */
      !!@ ili2db.dispName = "Ocupación"
      Ocupacion,
      /** En el ámbito de la gestión catastral, es el polígono que representa el asentamiento de personas naturales o jurídicas, con ánimo de señor y dueño sobre un predio privado, el cual puede contar o no con construcciones y/o edificaciones.
       */
      !!@ ili2db.dispName = "Posesión"
      Posesion
    );

    /** Uso económico de la propiedad inmobiliaria.
     */
    LC_DestinacionEconomicaTipo = (
      /** Se califica con destino acuícola, aquellos predios donde se realizan cultivos de organismos acuáticos, en ambientes naturales o artificiales.
       */
      !!@ ili2db.dispName = "Acuícola"
      Acuicola,
      /** Se califica con destino agrícola, aquellos predios con funcionalidad de laboreo agrícola, terrenos que han sido transformados y ocupados para la producción de cultivos cuyo objetivo es satisfacer las necesidades alimentarias, comerciales y agrícolas.
       * 
       * En caso de encontrar actividad agrícola y actividad pecuaria en un mismo predio, se califica según la actividad que predomine. Si, ambas actividades tienen el mismo porcentaje de participación en el predio, se debe calificar como agrícola.
       */
      !!@ ili2db.dispName = "Agrícola"
      Agricola,
      /** Se califica con destino agroindustrial, aquellos predios destinados a la actividad que implica cultivo (producción) y transformación (industrialización y comercialización) de productos agrícola, pecuario y forestal.
       */
      !!@ ili2db.dispName = "Agroindustrial"
      Agroindustrial,
      /** Predios con destinación agrícola y pecuaria.
       */
      !!@ ili2db.dispName = "Agropecuario"
      Agropecuario,
      /** Se califica con destino agroforestal, aquellos predios destinados al establecimiento y aprovechamiento combinado de especies forestales con actividades agrícolas o pecuarias con arreglos diferenciados. Incluye la actividad agrosilvícola, silvopastoril y agrosilvopastoril.
       */
      !!@ ili2db.dispName = "Agroforestal"
      Agroforestal,
      /** Se califica con destino comercial, aquellos predios cuya finalidad es la de realizar la actividad económica de ofrecer, transar o almacenar bienes y/o servicios a través de un mercader o comerciante.
       */
      !!@ ili2db.dispName = "Comercial"
      Comercial,
      /** Se califica con destino cultural, aquellos predios destinados al desarrollo de actividades artísticas.
       */
      !!@ ili2db.dispName = "Cultural"
      Cultural,
      /** Se califica con destino educativo, aquellos predios donde se desarrollan actividades académicas, tanto de la educación inicial, preescolar, básica, media y superior. Incluye los jardines infantiles, escuelas, colegios, institutos técnicos, fundaciones educativas, centros de investigación y universidades.
       */
      !!@ ili2db.dispName = "Educativo"
      Educativo,
      /** Se califica con destino forestal, aquellos predios con áreas naturales o seminaturales, constituidas principalmente por elementos arbóreos de especies nativas, exóticas e introducidas. Incluye las plantaciones forestales y los bosques naturales.
       */
      !!@ ili2db.dispName = "Forestal"
      Forestal,
      /** Se califica con destino habitacional, aquellos predios de uso residencial cuya finalidad es la vivienda habitual de las personas. Incluye los parqueaderos, garajes y depósitos dentro de propiedad horizontal como también los predios rurales de vivienda campestre.
       */
      !!@ ili2db.dispName = "Habitacional"
      Habitacional,
      /** Se califica con destino industrial, aquellos predios donde se desarrollan actividades de producción, fabricación, preparación, recuperación, reproducción, ensamblaje, construcción, transformación, tratamiento y manipulación de materias primas para producir bienes o productos materiales y que no estén clasificados dentro de los predios predios destinados a la extracción de recursos (mineros e hidrocarburos).
       */
      !!@ ili2db.dispName = "Industrial"
      Industrial,
      /** Se califica con destino infraestructura asociada a la producción agropecuaria, aquellos predios sobre los cuales se encuentra la infraestructura requerida dentro de la actividad agropecuaria y que son de interés para el sector agropecuario, como: bancos de maquinaria, plantas de almacenamiento, centros de acopio, centros de transformación agrícola, mataderos, etc.
       */
      !!@ ili2db.dispName = "Infraestructura asociada a producción agropecuaria"
      Infraestructura_Asociada_Produccion_Agropecuaria,
      /** Se califica con destino infraestructura hidráulica, aquellos predios sobre los cuales se encuentra establecida infraestructura para controlar, almacenar y conducir un flujo continuo de agua. Incluye los embalses, represas, acueductos, centrales de tratamiento y distribución, alcantarillados, estaciones depuradoras de aguas residenciales y distrito de adecuación de tierras.
       */
      !!@ ili2db.dispName = "Infraestructura hidráulica"
      Infraestructura_Hidraulica,
      /** Se califica con destino infraestructura de saneamiento básico, aquellos predios sobre los cuales se encuentra establecida la infraestructura para el saneamiento básico, con excepción del alcantarillado. Incluye los centros de acopio de basura y material reciclable, rellenos sanitarios e incineradoras.
       */
      !!@ ili2db.dispName = "Infraestructura de saneamiento básico"
      Infraestructura_Saneamiento_Basico,
      /** Se califica con destino infraestructura de seguridad, aquellos predios sobre los cuales se encuentra establecida infraestructura destina a salvaguardar el orden público. Incluye las estaciones de policía, batallones, cárceles, etc.
       */
      !!@ ili2db.dispName = "Infraestructura seguridad"
      Infraestructura_Seguridad,
      /** Se califica con destino infraestructura de transporte, aquellos  predios en los cuales se encuentra establecida infraestructura para el desarrollo de actividad de transporte, muelles para embarque, desembarque de carga y/o pasajeros, pistas de aterrizaje, torres de control, centros de almacenamiento y venta de combustible, etc. Se exceptúan de estas, aquellas plataformas flotantes y aquellas que se encuentren fuera de la plataforma continental.
       * 
       * Adicionalmente, hacen parte aquellos predios destinados en su totalidad a la comunicación en aeronavegación.
       */
      !!@ ili2db.dispName = "Infraestructura transporte"
      Infraestructura_Transporte,
      /** Se califica con destino institucional, aquellos predios destinados a la administración y prestación de servicios del Estado tanto de orden nacional como territorial.
       */
      !!@ ili2db.dispName = "Institucional"
      Institucional,
      /** Se califica con destino minería e hidrocarburos, aquellos predios donde se hace aprovechamiento directo de los recursos minerales o transformación primaria de los mismos.
       */
      !!@ ili2db.dispName = "Minería e hidrocarburos"
      Mineria_Hidrocarburos,
      /** Se califica con este destino, aquellos predios urbanos no construidos, ubicados en terrenos de grandes áreas que no han sido desarrollados y sin restricción legal para adelantar algún tipo de desarrollo urbanístico.
       */
      !!@ ili2db.dispName = "Lote urbanizable no urbanizado"
      Lote_Urbanizable_No_Urbanizado,
      /** Se califica con este destino, aquellos predios urbanos no construidos, ubicados en zonas urbanizadas, es decir, con infraestructura de servicios públicos e infraestructura vial.
       */
      !!@ ili2db.dispName = "Lote urbanizado no construido"
      Lote_Urbanizado_No_Construido,
      /** Se califica con este destino, aquellos predios urbanos o rurales clasificados por el instrumento de planeación como suelo de protección, también se incluyen los predios con afectación, por ejemplo los utilizados como servidumbres para los servicios públicos.
       */
      !!@ ili2db.dispName = "Lote no urbanizable"
      Lote_No_Urbanizable,
      /** Se califica con destino pecuario, aquellos predios destinados a la cría, beneficio y aprovechamiento de especies de animales no domésticos, para el consumo humano (productos cárnicos y lácteos), uso artesanal (lana, cuero, plumas, etc.) y conservación de fauna (zoocría).
       */
      !!@ ili2db.dispName = "Pecuario"
      Pecuario,
      /** Se califica con destino recreacional, aquellos predios que corresponden a equipamientos deportivos y recreativos, parques de propiedad privada o pública, clubes, generando bienestar físico y social.
       */
      !!@ ili2db.dispName = "Recreacional"
      Recreacional,
      /** Se califica con destino religioso, aquellos predios cuya finalidad es el culto religioso público, incluye las parroquias, basílicas, catedrales, santuarios, capillas, colegiatas, monasterios, conventos y seminarios.
       */
      !!@ ili2db.dispName = "Religioso"
      Religioso,
      /** Se califica con destino salubridad, aquellos predios destinados al cuidado de la salud de los ciudadanos, incluye los hospitales, centros de salud, clínicas, laboratorios y consultorios que prestan el servicio de salud tanto carácter público o privado.
       */
      !!@ ili2db.dispName = "Salubridad"
      Salubridad,
      /** Se califica con destino infraestructura de servicios funerarios, aquellos predios que prestan servicios de velatorio, cremación y entierro de personas fallecidas, incluye los cementerios, funerarias, morgue, anfiteatros, crematorios y demás relacionados.
       */
      !!@ ili2db.dispName = "Servicios funerarios"
      Servicios_Funerarios,
      /** Se califica con destino uso público, aquellos predios urbanos o rurales, que conforman el espacio público, como las zonas verdes, alamedas, plazas (no se incluyen las plazas de mercado), plazoletas parques, cuerpos de agua, áreas de control y protección ambiental, túneles, vías, ciclorutas, glorietas, etc.
       */
      !!@ ili2db.dispName = "Uso público"
      Uso_Publico
    );

    LC_FuenteAdministrativaTipo
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_FuenteAdministrativaTipo = (
      /** Documento público es el otorgado por el funcionario público en ejercicio de sus funciones o con su intervención. Así mismo, es público el documento otorgado por un particular en ejercicio de funciones públicas o con su intervención. Cuando consiste en un escrito autorizado o suscrito por el respectivo funcionario, es instrumento público; cuando es autorizado por un notario o quien haga sus veces y ha sido incorporado en el respectivo protocolo, se denomina escritura pública.
       */
      !!@ ili2db.dispName = "Documento público"
      Documento_Publico(
        /** Una escritura pública es un documento público en el que se realiza ante un notario público un determinado hecho o un derecho autorizado por dicho fedatario público, que firma con el otorgante u otorgantes,mostrando sobre la capacidad jurídica del contenido y de la fecha en que se realizó
         */
        !!@ ili2db.dispName = "(Documento público) Escritura pública"
        Escritura_Publica,
        /** La sentencia es la resolución judicial definitiva dictada por un juez o tribunal que pone fin a la litis o caso sometido a su conocimiento y cierra definitivamente su actuación en el mismo
         */
        !!@ ili2db.dispName = "(Documento público) Sentencia judicial"
        Sentencia_Judicial,
        /** Un acto administrativo es toda manifestación o declaración emanada de la administración pública en el ejercicio de potestades administrativas, mediante el que impone su voluntad sobre los derechos, libertades o intereses de otros sujetos públicos o privados y que queda bajo el del comienzo.
         */
        !!@ ili2db.dispName = "(Documento público) Acto administrativo"
        Acto_Administrativo
      ),
      /** Cuando no se halla documento soporte pero puede ser una declaración verbal.
       */
      !!@ ili2db.dispName = "(Sin documento)"
      Sin_Documento
    );

    /** En el ámbito de la gestión catastral, es el inmueble no separado por otro predio, con o sin construcciones y/o edificaciones y vinculado con personas naturales o jurídicas mediante u na relación de tenencia justificada con título de propiedad debidamente registrado.
     */
    LC_PredioTipo
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadAdministrativaBasicaTipo = (
      Predio(
        /** Es el predio que pertenece al estado y/o cuyo propietario es una entidad de derecho público.
         */
        !!@ ili2db.dispName = "(Predio) Público"
        Publico(
          /** Es un bien inmueble de propiedad de la Nación y ubicado en zonas rurales.
           */
          !!@ ili2db.dispName = "(Predio) (Público) Baldío"
          Baldio,
          /** Los bienes de la Unión cuyo uso no pertenece generalmente a los habitantes, se llaman bienes de la Unión o bienes fiscales.
           * 
           * Son bienes patrimoniales los de titularidad de las administraciones públicas que no tengan el carácter de bienes de dominio público, es decir, que no estén destinados directamente al uso público o afectados a un servicio público. Si no consta la afectación de un bien se presume su carácter patrimonial.
           */
          !!@ ili2db.dispName = "(Predio) (Público) Fiscal Patrimonial"
          Fiscal_Patrimonial,
          /** Son aquellos inmuebles de dominio público cuyo uso pertenece a todos los habitantes del territorio nacional, destinados al uso o disfrute colectivo.
           */
          !!@ ili2db.dispName = "(Predio) (Público) Uso público"
          Uso_Publico,
          /** Son aquellos tipos de predios que no son posibles de identificar ni clasificar como predios baldíos, fiscales patrimoniales o uso público.
           */
          !!@ ili2db.dispName = "(Predio) (Público) Público"
          Publico
        ),
        /** Es aquel que ha salido del patrimonio del estado, cuenta con un propietario inscrito en el folio de matrícula y se considera propiedad privada en los términos del artículo 48 de la Ley 160 de 1993.
         */
        !!@ ili2db.dispName = "(Predio) Privado"
        Privado
      )
    );

    LC_ResultadoVisitaTipo = (
      /** Tuvo acceso total al predio.
       */
      !!@ ili2db.dispName = "Exitoso"
      Exitoso,
      /** Tuvo acceso parcial al predio.
       */
      !!@ ili2db.dispName = "Incompleto"
      Incompleto,
      /** Sin atención por parte de personas. Predio Desocupado.
       */
      !!@ ili2db.dispName = "No hay nadie"
      No_Hay_Nadie,
      /** No permitieron acceso al predio.
       */
      !!@ ili2db.dispName = "No permitieron acceso"
      No_Permitieron_Acceso,
      /** No hay adulto en el momento de la visita.
       */
      !!@ ili2db.dispName = "Menor de edad"
      Menor_Edad,
      /** Por temas de seguridad asociados a orden público no es posible el acceso.
       */
      !!@ ili2db.dispName = "Situación de orden público"
      Situacion_Orden_Publico,
      /** Por limitaciones relacionadas con la topografía o accidentes geográficos no hubo acceso al predio.
       */
      !!@ ili2db.dispName = "Zona de difícil acceso"
      Zona_Dificil_Acceso,
      /** Predio en el cual no se realizó visita.
       */
      !!@ ili2db.dispName = "Sin Visita"
      Sin_Visita
    );

  TOPIC Levantamiento_Catastral
  EXTENDS LADM_COL_V3_1.LADM_Nucleo =
    OID AS INTERLIS.UUIDOID;
    DEPENDS ON LADM_COL_V3_1.LADM_Nucleo,Submodelo_Integracion_Insumos_V1_0.Datos_Integracion_Insumos;

    /** Clase que hereda los atributos de la  Clase COL_AgrupacionInteresados.
     */
    !!@ ili2db.dispName = "(CR) Agrupación de Interesados"
    CLASS CR_AgrupacionInteresados
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_AgrupacionInteresados =
    END CR_AgrupacionInteresados;

    /** Clase que permite agrupar las unidades de construcción por identificador, uso y tipología.
     */
    !!@ ili2db.dispName = "(CR) Características de la unidad de construcción"
    CLASS CR_CaracteristicasUnidadConstruccion
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.ObjetoVersionado =
      /** Identificador de la unidad de construcción, su codificación puede ser por letras del abecedario.
       */
      !!@ ili2db.dispName = "Identificador"
      Identificador : MANDATORY TEXT*20;
      /** Es el conjunto de elementos constructivos que conforman una edificación y que de acuerdo a sus características pueden ser consideradas convencionales cuando son de uso residencial, comercial e industrial o no convencionales cuando son anexos de la construcción.
       */
      !!@ ili2db.dispName = "Tipo de unidad de construcción"
      Tipo_Unidad_Construccion : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_UnidadConstruccionTipo;
      /** Número total de plantas en la unidad de construcción.
       */
      !!@ ili2db.dispName = "Total de plantas"
      Total_Plantas : 0 .. 150;
      /** Destinación de los materiales de una unidad constructiva con respecto a la actividad económica desarrollada en la edificación del predio.
       */
      !!@ ili2db.dispName = "Uso"
      Uso : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_UsoUConsTipo;
      /** Año de construcción de la unidad de construcción.
       */
      !!@ ili2db.dispName = "Año de construcción"
      Anio_Construccion : 1512 .. 2500;
      /** Área total construida en la unidad de construcción.
       */
      !!@ ili2db.dispName = "Área construida"
      Area_Construida : MANDATORY 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Área total privada de la unidad de construcción para los predios en régimen de propiedad horizontal.
       */
      !!@ ili2db.dispName = "Área privada construida"
      Area_Privada_Construida : 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Observaciones generales respecto de la unidad de construcción.
       */
      !!@ ili2db.dispName = "Observaciones"
      Observaciones : TEXT;
    END CR_CaracteristicasUnidadConstruccion;

    /** Es la unión de materiales adheridos al terreno, con carácter de permanente, cualesquiera sean los elementos que la constituyan.
     */
    !!@ ili2db.dispName = "(CR) Construcción"
    CLASS CR_Construccion
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadEspacial =
      /** Identificador de la unidad de construcción, su codificación puede ser por letras del abecedario.
       */
      !!@ ili2db.dispName = "Identificador"
      Identificador : MANDATORY TEXT*20;
      /** Número total de pisos de la construcción.
       */
      !!@ ili2db.dispName = "Total de pisos"
      Total_Pisos : MANDATORY 0 .. 300;
      /** Número total de sótanos de la construcción.
       */
      !!@ ili2db.dispName = "Total de sótanos"
      Total_Sotanos : 0 .. 99;
      /** Número total de mezanines de la construcción.
       */
      !!@ ili2db.dispName = "Total de mezanines"
      Total_Mezanines : 0 .. 99;
      /** Número total de semisótanos de la construcción.
       */
      !!@ ili2db.dispName = "Total de semisótanos"
      Total_Semisotanos : 0 .. 99;
      /** Área total construida.
       */
      !!@ ili2db.dispName = "Área total de la construcción"
      Area_Total_Construccion : MANDATORY 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Altura total de la construcción.
       */
      !!@ ili2db.dispName = "Altura total de la construcción"
      Altura_Total_Construccion : 0.00 .. 1000.00 [INTERLIS.m];
      /** Corresponde a la relación de puntos, líneas, polígono y volumen que en su conjunto tienen propiedades de espacio y estructura, que definen la construcción, es asignado por el sistema de captura.
       */
      !!@ ili2db.dispName = "Geometría"
      Geometria (EXTENDED) : MANDATORY ISO19107_PLANAS_V3_0.GM_MultiSurface3D;
    END CR_Construccion;

    /** Clase que contiene los datos principales del predio matriz sometido al régimen de propiedad horizontal.
     */
    !!@ ili2db.dispName = "(CR) Datos PH Condominio"
    CLASS CR_DatosPHCondominio =
      /** Área total del terreno del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total de terreno"
      Area_Total_Terreno : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Área total privada del terreno del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total de terreno privada"
      Area_Total_Terreno_Privada : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Área total de terreno común del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total de terreno común"
      Area_Total_Terreno_Comun : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Área total de construida del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total construida"
      Area_Total_Construida : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Área total construida privada del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total construida privada"
      Area_Total_Construida_Privada : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Área total construida común del PH o Condominio Matriz.
       */
      !!@ ili2db.dispName = "Área total construida común"
      Area_Total_Construida_Comun : 0.00 .. 99999999999999.98 [LADM_COL_V3_1.m2];
      /** Número de torres en el PH o Condominio.
       */
      !!@ ili2db.dispName = "Número de torres"
      Numero_Torres : 0 .. 1000;
      /** Total de unidades privadas en el PH o Condominio.
       */
      !!@ ili2db.dispName = "Total de unidades privadas"
      Total_Unidades_Privadas : 0 .. 99999999;
    END CR_DatosPHCondominio;

    /** Clase que hereda los atributos de la  Clase COL_FuenteEspacial.
     */
    !!@ ili2db.dispName = "(CR) Fuente Espacial"
    CLASS CR_FuenteEspacial
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_FuenteEspacial =
      /** Insumos utilizados para la obtención de información espacial en la definición en los linderos para cada predio.
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo (EXTENDED) : MANDATORY LADM_COL_V3_1.LADM_Nucleo.COL_FuenteEspacialTipo;
      /** Corresponde a la ficha técnica y especificaciones del insumo utilizado para el levantamiento catastral.
       */
      !!@ ili2db.dispName = "Metadato"
      Metadato (EXTENDED) : MTEXT;
    END CR_FuenteEspacial;

    /** Es la parte que tiene una relación con el predio por algún tipo de derecho, restricción, publicidad o responsabilidad.
     */
    !!@ ili2db.dispName = "(CR) Interesado"
    CLASS CR_Interesado
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_Interesado =
      /** Son considerados dos tipos de interesados, persona natural que actúa a nombre propio y se ocupa de algunas actividades que la ley considera mercantiles y persona jurídica que actúa como institución creada por una o más personas para cumplir un objetivo social que puede ser con o sin fines de lucro.
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_InteresadoTipo;
      /** Clase de documentos públicos que permite la identificación del interesado.
       */
      !!@ ili2db.dispName = "Tipo de documento"
      Tipo_Documento : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_DocumentoTipo;
      /** Documento público que contiene datos de identificación personal y que caracteriza al interesado como ciudadano, relacionado mediante un número de identificación.
       */
      !!@ ili2db.dispName = "Documento de identidad"
      Documento_Identidad : MANDATORY TEXT*50;
      /** Primer nombre de la persona interesada en trámite o proceso.
       */
      !!@ ili2db.dispName = "Primer nombre"
      Primer_Nombre : TEXT*100;
      /** Segundo nombre de la persona interesada en trámite o proceso.
       */
      !!@ ili2db.dispName = "Segundo nombre"
      Segundo_Nombre : TEXT*100;
      /** Primer apellido de la persona interesada en trámite o proceso.
       */
      !!@ ili2db.dispName = "Primer apellido"
      Primer_Apellido : TEXT*100;
      /** Segundo apellido de la persona interesada en trámite o proceso.
       */
      !!@ ili2db.dispName = "Segundo apellido"
      Segundo_Apellido : TEXT*100;
      /** Corresponde a “Masculino” y “Femenino” según como aparezca en el tipo de documento de identidad.
       */
      !!@ ili2db.dispName = "Sexo"
      Sexo : Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_SexoTipo;
      /** Grupo de personas a la cual pertenece el interesado, quienes comparten una misma ideología cultural.
       */
      !!@ ili2db.dispName = "Grupo étnico"
      Grupo_Etnico : Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_GrupoEtnicoTipo;
      /** Nombre jurídico que recibe un sociedad colectiva o empresa constituida legalmente, con el cual se encuentra inscrito.
       */
      !!@ ili2db.dispName = "Razón social"
      Razon_Social : TEXT*255;
    END CR_Interesado;

    /** Linea de división que separa un bien inmueble de otro, que puede o no estar materializada físicamente.
     */
    !!@ ili2db.dispName = "(CR) Lindero"
    CLASS CR_Lindero
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_CadenaCarasLimite =
      /** Longitud en metros del lindero.
       */
      !!@ ili2db.dispName = "Longitud"
      Longitud : MANDATORY 0.0 .. 100000000000.0 [INTERLIS.m];
    END CR_Lindero;

    /** Puntos topográficos o geodésicos utilizados como amarre para la ejecución del levantamiento catastral.
     */
    !!@ ili2db.dispName = "(CR) Punto Control"
    CLASS CR_PuntoControl
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_Punto =
      /** Nombre o código del punto de control.
       */
      !!@ ili2db.dispName = "ID del punto de control"
      ID_Punto_Control : MANDATORY TEXT*255;
      /** Indica la clasificación del tipo de punto de acuerdo a sus características.
       */
      !!@ ili2db.dispName = "Tipo de punto"
      PuntoTipo (EXTENDED) : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_PuntoTipo;
      /** Es el método utilizado para definir puntos de terreno que son identificables dentro de una fotografía, a los cuales se les puede determinar las coordenadas terrestres de linderos y vértices una vez realizada su digitalización.
       */
      !!@ ili2db.dispName = "Tipo de punto de control"
      Tipo_Punto_Control : Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_PuntoControlTipo;
      /** Describe la cercanía en posición de los objetos en el conjunto de datos, con respecto a sus posiciones verdaderas (o las asumidas como verdaderas).
       */
      !!@ ili2db.dispName = "Exactitud horizontal"
      Exactitud_Horizontal : 0.000 .. 10.000 [INTERLIS.m];
      !!@ name = "ValidacionValoresPuntoTipo"
      MANDATORY CONSTRAINT PuntoTipo <> #Control ;
      MANDATORY CONSTRAINT PuntoTipo <> #Otro ;
    END CR_PuntoControl;

    /** Punto que define la frontera de un predio con otro. La sucesión de estos puntos forma una línea que representa el límite entre dos terrenos. Asignado por el sistema de captura.
     */
    !!@ ili2db.dispName = "(CR) Punto Lindero"
    CLASS CR_PuntoLindero
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_Punto =
      /** Nombre o código que identifica el punto lindero.
       */
      !!@ ili2db.dispName = "ID del punto de lindero"
      ID_Punto_Lindero : MANDATORY TEXT*255;
      /** Indica la clasificación del tipo de punto de acuerdo a sus características.
       */
      !!@ ili2db.dispName = "Tipo de punto"
      PuntoTipo (EXTENDED) : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_PuntoTipo;
      /** Indica si existe desacuerdo o no entre los colindantes en relación al punto lindero que se está midiendo.
       */
      !!@ ili2db.dispName = "Desacuerdo"
      Desacuerdo : MANDATORY BOOLEAN;
      /** Es el método utilizado para definir puntos de terreno que son identificables dentro de una fotografía, a los cuales se les puede determinar las coordenadas terrestres de linderos y vértices una vez realizada su digitalización.
       */
      !!@ ili2db.dispName = "Fotoidentificación"
      Fotoidentificacion : Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_FotoidentificacionTipo;
      /** Describe la cercanía en posición de los objetos en el conjunto de datos, con respecto a sus posiciones verdaderas (o las asumidas como verdaderas).
       */
      !!@ ili2db.dispName = "Exactitud horizontal"
      Exactitud_Horizontal : 0.000 .. 10.000 [INTERLIS.m];
      !!@ name = "ValidacionValoresPuntoTipo"
      MANDATORY CONSTRAINT PuntoTipo <> #Control ;
      MANDATORY CONSTRAINT PuntoTipo <> #Otro ;
    END CR_PuntoLindero;

    /** Porción de tierra con una extensión geográfica definida.
     */
    !!@ ili2db.dispName = "(CR) Terreno"
    CLASS CR_Terreno
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadEspacial =
      /** Área total del terreno resultante del levantamiento catastral.
       */
      !!@ ili2db.dispName = "Área de terreno"
      Area_Terreno : MANDATORY 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Corresponde a la figura geométrica vectorial poligonal, generada a partir de los linderos del predio.
       */
      !!@ ili2db.dispName = "Geometría"
      Geometria (EXTENDED) : MANDATORY ISO19107_PLANAS_V3_0.GM_MultiSurface3D;
    END CR_Terreno;

    /** Es cada conjunto de materiales consolidados dentro de un predio que tiene unas características específicas en cuanto a elementos constitutivos físicos y usos de la misma.
     */
    !!@ ili2db.dispName = "(CR) Unidad de Construcción"
    CLASS CR_UnidadConstruccion
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadEspacial =
      /** Indica el tipo de planta donde se ubica la unidad de construcción.
       */
      !!@ ili2db.dispName = "Tipo de planta"
      Tipo_Planta : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_ConstruccionPlantaTipo;
      /** Indica numéricamente la ubicación de la planta.
       */
      !!@ ili2db.dispName = "Ubicación de la planta"
      Planta_Ubicacion : MANDATORY 0 .. 300;
      /** Área total construida en la unidad de construcción.
       */
      !!@ ili2db.dispName = "Área construida de la planta"
      Area_Construida : MANDATORY 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Altura total de la planta.
       */
      !!@ ili2db.dispName = "Altura de la planta"
      Altura : 1 .. 1000 [INTERLIS.m];
      /** Corresponde a la relación de puntos, líneas, polígono y volumen que en su conjunto tienen propiedades de espacio y estructura, que definen la construcción, es asignado por el sistema de captura.
       */
      !!@ ili2db.dispName = "Geometría"
      Geometria (EXTENDED) : ISO19107_PLANAS_V3_0.GM_MultiSurface3D;
    END CR_UnidadConstruccion;

    /** Referencia a una clase externa para gestionar referencias registrales del sistema antiguo.
     */
    !!@ ili2db.dispName = "Referencia Registral del Sistema Antiguo"
    STRUCTURE ExtReferenciaRegistralSistemaAntiguo =
      /** Valores: Estructurada y No Estructurada.
       */
      !!@ ili2db.dispName = "Tipo de referencia"
      Tipo_Referencia : MANDATORY (
        !!@ ili2db.dispName = "Estructurada"
        Estructurada,
        !!@ ili2db.dispName = "No estructurada"
        No_Estructurada
      );
      /** Nombre de la oficina de registro de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName = "Oficina"
      Oficina : TEXT*50;
      /** Número del libro indicado en el ficha catastral.
       */
      !!@ ili2db.dispName = "Libro"
      Libro : TEXT*1;
      /** Número del tomo indicado en el ficha catastral.
       */
      !!@ ili2db.dispName = "Tomo"
      Tomo : TEXT*2;
      /** Página de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName = "Pagina"
      Pagina : TEXT*4;
      /** Número de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName = "Número"
      Numero : TEXT*4;
      /** Día de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName = "Día"
      Dia : TEXT*2;
      /** Mes de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      Mes : TEXT*2;
      /** Año de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName = "Año"
      Anio : TEXT*2;
      /** Número de la matrícula de la referencia registral sistema antiguo diligenciada en la ficha catastral.
       */
      !!@ ili2db.dispName = "Matrícula"
      Matricula : MANDATORY TEXT*20;
    END ExtReferenciaRegistralSistemaAntiguo;

    !!@ ili2db.dispName = "(LC) Contacto Visita"
    CLASS LC_ContactoVisita =
      /** Nombres y apellidos de la persona encargada de atender la visita de ejecución de actividades catastrales sobre el predio.
       */
      !!@ ili2db.dispName = "Nombres y apellidos de quien atendió"
      Nombres_Apellidos_Quien_Atendio : MANDATORY TEXT*150;
      /** Indica el tipo de documento de la persona que atendió la visita predial.
       */
      !!@ ili2db.dispName = "Tipo de documento de quien atendió la visita predial"
      Tipo_Documento_Quien_Atendio : Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.CR_DocumentoTipo;
      /** Indica el número de documento de la persona que atendió la visita predial.
       */
      !!@ ili2db.dispName = "Numero de documento de quien atendió la visita predial"
      Numero_Documento_Quien_Atendio : TEXT*50;
      /** Dirección de domicilio para notificaciones.
       */
      !!@ ili2db.dispName = "Domicilio notificaciones"
      Domicilio_Notificaciones : TEXT*255;
      /** Número de celular de la persona que atendió la visita de actividades catastrales.
       */
      !!@ ili2db.dispName = "Celular"
      Celular : TEXT*20;
      /** Correo electrónico de la persona que atendió la visita de actividades catastrales.
       */
      !!@ ili2db.dispName = "Correo electrónico"
      Correo_Electronico : TEXT*100;
      /** Indica si autoriza las notificaciones administrativas por medio de vía electrónica.
       */
      !!@ ili2db.dispName = "Autoriza notificaciones"
      Autoriza_Notificaciones : BOOLEAN;
    END LC_ContactoVisita;

    /** Clase que registra las instancias de los derechos que un interesado ejerce sobre un predio. Es una especialización de la clase COL_DRR del propio modelo.
     */
    !!@ ili2db.dispName = "(LC) Derecho"
    CLASS LC_Derecho
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_DRR =
      /** Forma de relación del interesado con respecto al predio según su forma de tenencia (posesión, ocupación o dominio).
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.LC_DerechoTipo;
      /** Indica la fracción del derecho en relación a la forma de tenencia y el área que esta ocupa dentro de la extensión del predio.
       * 
       * Expresado en tanto por uno (0.0000000000 a 1.0000000000).
       */
      !!@ ili2db.dispName = "Fracción de derecho"
      Fraccion_Derecho : MANDATORY 0.0000000000 .. 1.0000000000;
      /** Fecha de inicio de tenencia del interesado con respecto al predio.
       */
      !!@ ili2db.dispName = "Fecha de inicio de tenencia"
      Fecha_Inicio_Tenencia : INTERLIS.XMLDate;
    END LC_Derecho;

    /** Estructura que permite identificar las modificaciones que puede tener el número predial producto de la dinámica inmobiliaria identificada en el levantamiento catastral.
     */
    !!@ ili2db.dispName = "(LC) Estructura Novedad Número Predial"
    STRUCTURE LC_EstructuraNovedadNumeroPredial =
      /** El predio no sufre modificación del código predial nacional de 30 dígitos de acuerdo con la estructura.
       */
      !!@ ili2db.dispName = "Número predial"
      Numero_Predial : MANDATORY TEXT*30;
      /** Indica los diferentes tipos de modificaciones que puede tener el número predial producto de la dinámica inmobiliaria identificada en el levantamiento catastral.
       */
      !!@ ili2db.dispName = "Tipo de novedad"
      Tipo_Novedad : MANDATORY (
        !!@ ili2db.dispName = "Predio nuevo"
        Predio_Nuevo,
        !!@ ili2db.dispName = "Desenglobe"
        Desenglobe,
        !!@ ili2db.dispName = "Englobe"
        Englobe,
        !!@ ili2db.dispName = "Cancelación"
        Cancelacion,
        !!@ ili2db.dispName = "Cambio de número predial"
        Cambio_Numero_Predial
      );
    END LC_EstructuraNovedadNumeroPredial;

    /** Clase que almacena las fuentes administrativas (escrituras, sentencias, actos administrativos, etc) que sustentan el Derecho respecto de la relación de tenencia entre el Interesado y el predio.
     */
    !!@ ili2db.dispName = "(LC) Fuente Administrativa"
    CLASS LC_FuenteAdministrativa
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_FuenteAdministrativa =
      /** Documentos como escritura pública, sentencia judicial, acto administrativo, documento privado o sin documento (puede ser una declaración verbal), que acredita la adquisición de derechos de dominio sobre un bien inmueble y la relación que existe entre el interesado y el predio.
       */
      !!@ ili2db.dispName = "Tipo"
      Tipo (EXTENDED) : MANDATORY Modelo_Aplicacion_LADMCOL_Lev_Cat_V2_0.LC_FuenteAdministrativaTipo;
      /** Entidades encargadas de emitir el título de dominio, posesión u ocupación.
       */
      !!@ ili2db.dispName = "Ente emisor"
      Ente_Emisor : TEXT*255;
    END LC_FuenteAdministrativa;

    /** Datos de contacto de la parte interesada.
     */
    !!@ ili2db.dispName = "(LC) Interesado Contacto"
    CLASS LC_InteresadoContacto =
      /** Número de teléfono de contacto del interesado.
       */
      !!@ ili2db.dispName = "Teléfono 1"
      Telefono1 : TEXT*20;
      /** Domicilio para notificaciones del interesado.
       */
      !!@ ili2db.dispName = "Domicilio notificación"
      Domicilio_Notificacion : TEXT*500;
      /** Dirección de residencia del interesado.
       */
      !!@ ili2db.dispName = "Dirección de residencia"
      Direccion_Residencia : TEXT*500;
      /** Correo electrónico del interesado.
       */
      !!@ ili2db.dispName = "Correo electrónico"
      Correo_Electronico : TEXT*100;
      /** Indica si el interesado autoriza notificación vía correo electrónico.
       */
      !!@ ili2db.dispName = "Autoriza notificación correo"
      Autoriza_Notificacion_Correo : BOOLEAN;
      /** Departamento de residencia del interesado.
       */
      !!@ ili2db.dispName = "Departamento"
      Departamento : TEXT*100;
      /** Municipio de residencia del interesado.
       */
      !!@ ili2db.dispName = "Municipio"
      Municipio : TEXT*100;
    END LC_InteresadoContacto;

    /** Estructura que permite identificar las inconsistencias que puede tener el folio de matrícula inmobiliaria producto de la dinámica inmobiliaria identificada en el levantamiento catastral.
     */
    !!@ ili2db.dispName = "(LC) Novedad FMI"
    STRUCTURE LC_NovedadFMI =
      /** Es el consecutivo que se asigna a cada oficina de registro de instrumentos públicos.
       */
      !!@ ili2db.dispName = "Código ORIP"
      Codigo_ORIP : MANDATORY TEXT*4;
      /** Es el consecutivo que se asigna a cada predio jurídico abierto en la ORIP.
       */
      !!@ ili2db.dispName = "Número FMI"
      Numero_FMI : MANDATORY TEXT*80;
      /** Relaciona todas aquellas diferencias e inexactitudes relativas al registro de los predios respecto de la información juridica vigente.
       */
      !!@ ili2db.dispName = "Tipo Novedad FMI"
      Tipo_NovedadFMI : MANDATORY (
        /** Cuando el estado del FMI del predio en estudio es CERRADO ante la SNR, pero pese a haberse realizado varios negocios jurídicos sobre un predio (ventas, donaciones, segregaciones, etc.) se identifica que este posee un área de remanente, lo que le permite continuar con su existencia jurídica y su estado debe cambiar a ABIERTO.
         */
        !!@ ili2db.dispName = "FMI debe estar abierto"
        FMI_Debe_Estar_Abierto,
        /** Cuando el estado del FMI del predio en estudio es ABIERTO ante la SNR, pero el folio ha sido cancelado por orden de autoridad  judicial y/o administrativa, o se agote su área por englobes, desenglobes o cualquier otro negocio jurídico  y su estado debe cambiar a CERRADO.
         */
        !!@ ili2db.dispName = "FMI debe estar cerrado"
        FMI_Debe_Estar_Cerrado,
        /** Cuando no exista relación entre el predio segregado y el que se enuncia.
         */
        !!@ ili2db.dispName = "FMI no es segregado del que se enuncia"
        FMI_No_Es_Segregado_Del_Que_Se_Enuncia,
        /** Cuando se ha aperturado dos o mas FMI sobre un mismo predio, en un mismo circulo registral o círculos registrales diferentes.
         */
        !!@ ili2db.dispName = "FMI duplicado sobre el mismo bien inmueble"
        FMI_Duplicado_Sobre_El_Mismo_Bien_Inmueble,
        /** Cuando se presente una inconsistencia en el código registral con el que se registró el acto jurídico
         */
        !!@ ili2db.dispName = "FMI con error en la identificación de naturaleza jurídica del acto"
        FMI_Con_Error_En_La_Identificacion_De_Naturaleza_Juridica_Del_Acto,
        /** Cuando se encuentra un titulo inscrito que no corresponde al predio objeto de estudio.
         */
        !!@ ili2db.dispName = "Título mal inscrito no corresponde al predio"
        Titulo_Mal_Inscrito_No_Corresponde_Al_Predio,
        /** FMI que después de la intervención, no fue posible identificar en territorio y no se encuentra relacionado a ningún predio del la base catastral resultante de la actualización.
         */
        !!@ ili2db.dispName = "FMI sin correspondencia catastral"
        FMI_Sin_Correspondencia_Catastral
      );
    END LC_NovedadFMI;

