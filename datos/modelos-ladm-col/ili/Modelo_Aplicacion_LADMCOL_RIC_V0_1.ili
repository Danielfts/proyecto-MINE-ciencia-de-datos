    /** Clase especializada de BaUnit, que describe la unidad administrativa bÃ¡sica para el caso de Colombia.
     * El predio es la unidad territorial legal propia de Catastro. Esta formada por el terreno y puede o no tener construcciones asociadas.
     */
    !!@ ili2db.dispName = "(SINIC) Predio"
    CLASS RIC_Predio
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadAdministrativaBasica =
      /** Corresponde al codigo del departamento al cual pertenece el predio. Es asignado por DIVIPOLA y tiene 2 dÃ­gitos.
       */
      !!@ ili2db.dispName = "Departamento"
      Departamento : MANDATORY TEXT*2;
      /** Corresponde al cÃ³digo del municipio al cual pertenece el predio. Es asignado por DIVIPOLA y tiene 3 dÃ­gitos.
       */
      !!@ ili2db.dispName = "Municipio"
      Municipio : MANDATORY TEXT*3;
      /** Es un cÃ³digo Ãºnico para identificar los inmuebles tanto en los sistemas de informaciÃ³n catastral como registral.
       */
      !!@ ili2db.dispName = "CÃ³digo homologado"
      Codigo_Homologado : MANDATORY TEXT*11;
      /** Es un cÃ³digo Ãºnico para identificar los inmuebles tanto en los sistemas de informaciÃ³n catastral como registral. El NUPRE no implicarÃ¡ supresiÃ³n de la numeraciÃ³n catastral ni registral asociada a la cÃ©dula catastral ni a la matrÃ­cula inmobiliaria actual.
       */
      !!@ ili2db.dispName = "NÃºmero Ãºnico predial"
      NUPRE : TEXT*11;
      /** Circulo registral
       */
      !!@ ili2db.dispName = "CÃ³digo ORIP"
      Codigo_ORIP : TEXT*3;
      /** Matricula inmobiliaria
       */
      !!@ ili2db.dispName = "MatrÃ­cula inmobiliaria"
      Matricula_Inmobiliaria : TEXT*80;
      /** Nuevo cÃ³digo nÃºmerico de treinta (30) dÃ­gitos, que se le asigna a cada predio y busca localizarlo inequÃ­vocamente en los documentos catastrales, segÃºn el modelo determinado por el Instituto GeogrÃ¡fico Agustin Codazzi.
       */
      !!@ ili2db.dispName = "NÃºmero predial"
      Numero_Predial : MANDATORY TEXT*30;
      /** Anterior cÃ³digo nÃºmerico de veinte (20) digitos, que se le asigna a cada predio y busca localizarlo inequÃ­vocamente en los documentos catastrales, segÃºn el modelo determinado por el Instituto GeogrÃ¡fico Agustin Codazzi.
       */
      !!@ ili2db.dispName = "NÃºmero predial anterior"
      Numero_Predial_Anterior : TEXT*20;
      !!@ ili2db.dispName = "Fecha de inscripciÃ³n catastral"
      Fecha_Inscripcion_Catastral : INTERLIS.XMLDate;
      /** DirecciÃ³n del predio.
       */
      !!@ ili2db.dispName = "DirecciÃ³n"
      Direccion : BAG {1..*} OF LADM_COL_V3_1.LADM_Nucleo.ExtDireccion;
      /** Corresponde a una caracterizaciÃ³n temÃ¡tica de las condiciones de predio que se estÃ¡ censando relacionada a aspectos fÃ­sicos y jurÃ­dicos.
       */
      !!@ ili2db.dispName = "CondiciÃ³n del predio"
      Condicion_Predio : MANDATORY Modelo_Aplicacion_LADMCOL_RIC_V0_1.RIC_CondicionPredioTipo;
      /** Es la clasificaciÃ³n para fines estadÃ­sticos que se da a cada inmueble en su conjuntoâ€“terreno, construcciones o edificaciones-, en el momento de la identificaciÃ³n predial de conformidad con la actividad predominante que en Ã©l se desarrolle.
       */
      !!@ ili2db.dispName = "DestinaciÃ³n econÃ³mica"
      Destinacion_Economica : Modelo_Aplicacion_LADMCOL_RIC_V0_1.RIC_DestinacionEconomicaTipo;
      /** Indica el tipo predio para efectos catastrales.
       */
      !!@ ili2db.dispName = "Tipo de predio"
      Tipo (EXTENDED) : MANDATORY Modelo_Aplicacion_LADMCOL_RIC_V0_1.RIC_PredioTipo;
      /** El avalÃºo catastral consiste en la determinaciÃ³n del valor de los predios, obtenido mediante investigaciÃ³n y anÃ¡lisis estadÃ­stico del mercado inmobiliario. ?
       * El avalÃºo catastral de cada predio se determinarÃ¡ por la adiciÃ³n de los avalÃºos parciales practicados independientemente para los terrenos y para las unidades de construcciÃ³n en Ã©l comprendidos.?
       * El avalÃºo catastral corresponde a un porcentaje adoptado del avalÃºo comercial segÃºn el estudio econÃ³mico, dichos avalÃºos se redondean a miles.
       */
      !!@ ili2db.dispName = "AvalÃºo catastral"
      Avaluo_Catastral : MANDATORY LADM_COL_V3_1.LADM_Nucleo.Peso;
      /** Una unidad orgÃ¡nica catastral se divide en zonas: urbana y rural.
       */
      !!@ ili2db.dispName = "Zona"
      Zona : MANDATORY Modelo_Aplicacion_LADMCOL_RIC_V0_1.RIC_ZonaTipo;
      /** Estado de La informaciÃ³n fÃ­sica, jurÃ­dica y econÃ³mica, asÃ­ como la resultante de los procedimientos de enfoque multipropÃ³sito entrarÃ¡n en vigencia para efectos catastrales al momento de quedar en firme su inscripciÃ³n o incorporaciÃ³n en las bases oficiales descritas en el  decreto 148 de 2020.
       */
      !!@ ili2db.dispName = "Vigencia de la actualizaciÃ³n catastral"
      Vigencia_Actualizacion_Catastral : MANDATORY INTERLIS.XMLDate;
      /** Permite indicar el estado en el que se encuentra el predio al momento de la entrega.
       */
      !!@ ili2db.dispName = "Estado"
      Estado : MANDATORY Modelo_Aplicacion_LADMCOL_RIC_V0_1.RIC_EstadoTipo;
      /** Permite indicar el tipo de catastro que formo o actualizo el predio.
       */
      !!@ ili2db.dispName = "Catastro"
      Catastro : Modelo_Aplicacion_LADMCOL_RIC_V0_1.RIC_CatastroTipo;
      UNIQUE Codigo_Homologado;
      !!@ name = "ValidacionValoresPredioTipo"
      MANDATORY CONSTRAINT Tipo <> #Ordenamiento_Territorial ;
      MANDATORY CONSTRAINT Tipo <> #Servicios_Publicos ;
      MANDATORY CONSTRAINT Tipo <> #Reservas_Naturales ;
      MANDATORY CONSTRAINT Tipo <> #Parques_Naturales ;
      MANDATORY CONSTRAINT Tipo <> #Amenazas_Riesgos ;
      MANDATORY CONSTRAINT Tipo <> #Servidumbre ;
      MANDATORY CONSTRAINT Tipo <> #Superficies_Agua ;
      MANDATORY CONSTRAINT Tipo <> #Transporte ;
    END RIC_Predio;

    /** PorciÃ³n de tierra con una extensiÃ³n geogrÃ¡fica definida.
     */
    !!@ ili2db.dispName = "(SINIC) Terreno"
    CLASS RIC_Terreno
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadEspacial =
      /** Ãrea total del terreno resultante del levantamiento catastral.
       */
      !!@ ili2db.dispName = "Ãrea de terreno"
      Area_Terreno : MANDATORY 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Ãrea de terreno digital registrada en la base de datos catastral.
       */
      !!@ ili2db.dispName = "Ãrea digital del gestor"
      Area_Digital_Gestor : 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Corresponde a la relaciÃ³n de puntos, lÃ­neas, polÃ­gono y volumen que en su conjunto tienen propiedades de espacio y estructura, que definen el terreno, es asignado por el sistema de captura.
       */
      !!@ ili2db.dispName = "GeometrÃ­a"
      Geometria (EXTENDED) : MANDATORY ISO19107_PLANAS_V3_0.GM_MultiSurface3D;
    END RIC_Terreno;

    /** Clase que contiene los cambios que se presentan en los componentes fÃ­sico, jurÃ­dico o econÃ³mico de un predio, una vez han sido formados.
     */
    !!@ ili2db.dispName = "(SINIC) Tramite Catastral"
    CLASS RIC_TramiteCatastral =
      /** Para los efectos catastrales, las mutaciones se clasifican de acuerdo a lo definido en la resoluciÃ³n IGAC 1149 de 2021.
       */
      !!@ ili2db.dispName = "ClasificaciÃ³n de la MutaciÃ³n Catastral"
      Clasificacion_Mutacion : MANDATORY Modelo_Aplicacion_LADMCOL_RIC_V0_1.RIC_MutacionTipo;
      /** Numero de la resolucion de la mutaciÃ³n expedida por el gestor catastral.
       */
      !!@ ili2db.dispName = "NÃºmero de la resoluciÃ³n"
      Numero_Resolucion : MANDATORY TEXT*30;
      /** Fecha de la resolucion de la mutaciÃ³n expedida por el gestor catastral.
       */
      !!@ ili2db.dispName = "Fecha de la resoluciÃ³n"
      Fecha_Resolucion : MANDATORY INTERLIS.XMLDate;
      !!@ ili2db.dispName = "Fecha de radicaciÃ³n"
      Fecha_Radicacion : MANDATORY INTERLIS.XMLDate;
    END RIC_TramiteCatastral;

    /** Es cada conjunto de materiales consolidados dentro de un predio que tiene unas caracterÃ­sticas especÃ­ficas en cuanto a elementos constitutivos fÃ­sicos y usos de la misma.
     */
    !!@ ili2db.dispName = "(SINIC) Unidad de ConstrucciÃ³n"
    CLASS RIC_UnidadConstruccion
    EXTENDS LADM_COL_V3_1.LADM_Nucleo.COL_UnidadEspacial =
      /** Indica numÃ©ricamente la ubicaciÃ³n de la planta.
       */
      !!@ ili2db.dispName = "UbicaciÃ³n de la planta"
      Planta_Ubicacion : MANDATORY 0 .. 300;
      /** Ãrea total construida en la unidad de construcciÃ³n.
       */
      !!@ ili2db.dispName = "Ãrea construida de la planta"
      Area_Construida : MANDATORY 0.0 .. 99999999999999.9 [LADM_COL_V3_1.m2];
      /** Altura total de la planta.
       */
      !!@ ili2db.dispName = "Altura de la planta"
      Altura : 1 .. 1000 [INTERLIS.m];
      /** Corresponde a la relaciÃ³n de puntos, lÃ­neas, polÃ­gono y volumen que en su conjunto tienen propiedades de espacio y estructura, que definen la construcciÃ³n, es asignado por el sistema de captura.
       */
      !!@ ili2db.dispName = "GeometrÃ­a"
      Geometria (EXTENDED) : MANDATORY ISO19107_PLANAS_V3_0.GM_MultiSurface3D;
    END RIC_UnidadConstruccion;

    ASSOCIATION ric_construccion_unidadconstruccion =
      ric_unidadconstruccion -- {0..*} RIC_UnidadConstruccion;
      ric_construccion -<> {1} RIC_Construccion;
    END ric_construccion_unidadconstruccion;

    ASSOCIATION ric_ph_predio =
      ric_predio -- {1} RIC_Predio;
      ric_datos_ph -- {0..1} RIC_DatosPHCondominio;
    END ric_ph_predio;

    /** RelaciÃ³n entre unidades prediales y predios matrices bajo el rÃ©gimen de propiedad horizontal y condominio.
     */
    ASSOCIATION ric_predio_copropiedad =
      /** Area privada de terreno matriz, adicional a la participaciÃ³n en el terreno comÃºn, segÃºn el coeficiente allÃ­ determinado.
       */
      ric_unidad_predial -- {0..*} RIC_Predio;
      /** Unidades residenciales tales como edificios, conjuntos y tipos de urbanizaciones cerradas en las que se comparten Ã¡reas comunes y que tienen rÃ©gimen de propiedad horizontal.
       */
      ric_matriz -<> {0..1} RIC_Predio;
      /** Coeficiente de copropiedad de la unidad predial.
       */
      !!@ ili2db.dispName = "Coeficiente"
      Coeficiente : 0.0000000000 .. 1.0000000000;
    END ric_predio_copropiedad;

    ASSOCIATION ric_predio_gestorcatastral =
      ric_predio -- {1..*} RIC_Predio;
      ric_gestorcatastral -- {1} RIC_GestorCatastral;
    END ric_predio_gestorcatastral;

    ASSOCIATION ric_predio_informalidad =
      ric_predio_formal -- {0..*} RIC_Predio;
      ric_predio_informal -- {0..*} RIC_Predio;
    END ric_predio_informalidad;

    ASSOCIATION ric_predio_operadorcatastral =
      ric_predio -- {1..*} RIC_Predio;
      ric_operadorcatastral -- {1} RIC_OperadorCatastral;
    END ric_predio_operadorcatastral;

    ASSOCIATION ric_predio_tramitecatastral =
      ric_predio -- {0..*} RIC_Predio;
      ric_tramite_catastral -- {0..*} RIC_TramiteCatastral;
    END ric_predio_tramitecatastral;

    ASSOCIATION ric_unidadconstruccion_caracteristicasunidadconstruccion =
      ric_caracteristicasunidadconstruccion -- {1} RIC_CaracteristicasUnidadConstruccion;
      ric_unidadconsutruccion -- {1..*} RIC_UnidadConstruccion;
    END ric_unidadconstruccion_caracteristicasunidadconstruccion;

  END RIC;

END Modelo_Aplicacion_LADMCOL_RIC_V0_1.